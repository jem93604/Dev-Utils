# Serves frontend/dist over auto-TLS HTTPS and proxies same-origin /api/*
# to the backend. Frontend uses HashRouter + relative /api/v1 baseURL, so
# no SPA rewrite config needed.
# Caddy provisions a Let's Encrypt cert on first request; port 80 stays
# open for the ACME HTTP challenge + HTTP->HTTPS redirect.
7736735924.xyz {
	root * /srv
	encode gzip

	@api path /api/* /health
	handle @api {
		reverse_proxy api:8001
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	log
}
