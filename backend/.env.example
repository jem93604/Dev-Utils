DATABASE_URL=sqlite:///./sqlhub.db
AUTH_ENABLED=true
ALLOW_SIGNUP=true
# Generate with: openssl rand -hex 32. The API refuses to boot with the
# shipped default while AUTH_ENABLED=true unless you explicitly opt into
# insecure local dev via ALLOW_INSECURE_DEFAULT_SECRET=true.
ALLOW_INSECURE_DEFAULT_SECRET=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_DAYS=3
# Per-IP per-minute caps for brute-force / abuse-prone endpoints.
AUTH_RATE_LIMIT_PER_MIN=10
MEDIA_RATE_LIMIT_PER_MIN=20
